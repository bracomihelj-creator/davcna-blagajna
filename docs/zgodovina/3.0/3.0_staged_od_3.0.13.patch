+              if (aKey && fire(aKey)) return {{ ok: true, how: 'name_key', text: (aKey.innerText||'').trim() }};
+            }}
+          }}
+          if (oid) {{
+            const byData = document.querySelector('[data-organizacijaid="' + oid + '"]');
+            if (byData) {{
+              const l = byData.querySelector('a.organizacija-naziv, a') || byData;
+              if (fire(l)) return {{ ok: true, how: 'id', text: (l.innerText||'').trim() }};
+            }}
+          }}
+          return {{
+            ok: false,
+            how: 'not_found',
+            rows: document.querySelectorAll('[data-organizacijaid], a.organizacija-naziv').length,
+            path: location.pathname || ''
+          }};
+        }})()
+        """
+        deadline = time.monotonic() + 18
+        last: Dict[str, Any] = {}
+        while time.monotonic() < deadline:
+            last = dict(self.eval(script) or {})
+            if last.get("ok"):
