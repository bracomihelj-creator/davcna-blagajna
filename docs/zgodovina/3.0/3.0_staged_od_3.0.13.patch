+
+    def select_podatki_kn(self) -> Dict[str, Any]:
+        """Korak 1 Hitri zajem: Podatki → Knjižbe in DDV (razširi obrazec)."""
+        script = f"""
+        (() => {{
+          const tipWant = {json.dumps(TIP_LABEL)};
+          const norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim().toLowerCase();
+          const steps = [];
+          const hasForm = Boolean(document.querySelector('#PPC_EPC_DC_I_Datum') || document.querySelector('#PPC_EPC_DC_I_Moznosti_1'));
+          const vp = document.querySelector('#PPC_EPC_DC_I_VrstaPrometa_h');
+          if (vp && String(vp.value || '').toUpperCase() === 'KN' && hasForm) {{
+            return {{ ok: true, steps: ['KN_already'], has_form: true }};
+          }}
+          const setNative = (el, val) => {{
+            if (!el) return false;
+            try {{
+              const desc = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
+              if (desc && desc.set) desc.set.call(el, val); else el.value = val;
+            }} catch (e) {{ el.value = val; }}
+            el.dispatchEvent(new Event('input', {{ bubbles: true }}));
+            el.dispatchEvent(new Event('change', {{ bubbles: true }}));
+            el.dispatchEvent(new Event('blur', {{ bubbles: true }}));
+            return true;
+          }};
+          if (vp) {{ setNative(vp, 'KN'); steps.push('KN_h'); }}
+          const inputs = Array.from(document.querySelectorAll('input.mm-select-input, input[type=text]'));
+          let podatkiInp = null;
+          for (const inp of inputs) {{
+            const wrap = inp.closest('.input-group, .form-group, td, div') || inp.parentElement;
+            let lab = '';
+            try {{
+              const prev = wrap && wrap.previousElementSibling;
+              lab = ((prev && (prev.innerText || prev.textContent)) || '') + ' ' + (inp.getAttribute('aria-label') || '') + ' ' + (inp.id || '');
+              if (inp.id) {{
+                const fl = document.querySelector('label[for=\"' + inp.id + '\"]');
+                if (fl) lab += ' ' + (fl.innerText || '');
+              }}
+            }} catch (e) {{}}
+            if (/podatk/i.test(lab) || /VrstaPrometa/i.test(inp.id || '')) {{ podatkiInp = inp; break; }}
+          }}
+          if (!podatkiInp && inputs.length) {{
+            podatkiInp = inputs.find(i => !(i.value || '').trim()) || inputs[0];
+          }}
+          if (podatkiInp) {{
+            try {{ podatkiInp.focus(); podatkiInp.click(); }} catch (e) {{}}
+            const btn = (podatkiInp.closest('.input-group') || podatkiInp.parentElement || document)
+              .querySelector('button, .mm-select-btn, .dropdown-toggle');
+            if (btn) {{ try {{ btn.click(); }} catch (e) {{}} }}
+            setNative(podatkiInp, tipWant);
+            try {{
+              podatkiInp.dispatchEvent(new KeyboardEvent('keydown', {{ key: 'ArrowDown', bubbles: true }}));
+              podatkiInp.dispatchEvent(new KeyboardEvent('keydown', {{ key: 'Enter', bubbles: true }}));
+            }} catch (e) {{}}
+            const opts = Array.from(document.querySelectorAll('li, .mm-select-item, .dropdown-item, [role=option], a, span, div'));
+            const hit = opts.find(el => {{
+              const t = norm(el.innerText || el.textContent || el.getAttribute('title'));
+              if (!t || t.length > 80) return false;
+              return t.includes('knjižbe in ddv') || t.includes('knjizbe in ddv') || t === 'kn' || /\\bkn\\b/.test(t);
+            }});
+            if (hit) {{ try {{ hit.click(); steps.push('KN_opt'); }} catch (e) {{ steps.push('KN_typed'); }} }}
+            else steps.push('KN_typed');
+          }}
+          const formNow = Boolean(document.querySelector('#PPC_EPC_DC_I_Datum') || document.querySelector('#PPC_EPC_DC_I_Moznosti_1'));
+          return {{ ok: steps.length > 0 || formNow, steps, has_form: formNow, vp: vp ? (vp.value || '') : '' }};
+        }})()
+        """
+        result = self.eval(script)
+        return dict(result or {}) if isinstance(result, dict) else {"ok": False}
+
+    def fill_form(self, *, date_sl: str, opis: str) -> Dict[str, Any]:
+        script = f"""
+        (() => {{
+          const dateVal = {json.dumps(date_sl)};
+          const opisVal = {json.dumps(opis)};
+          const vrstaWant = {json.dumps(VRSTA_LABEL)};
+          const setNative = (el, val) => {{
+            if (!el) return false;
+            try {{
+              const desc = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
+              if (desc && desc.set) desc.set.call(el, val); else el.value = val;
+            }} catch (e) {{ el.value = val; }}
+            el.dispatchEvent(new Event('input', {{ bubbles: true }}));
+            el.dispatchEvent(new Event('change', {{ bubbles: true }}));
+            el.dispatchEvent(new Event('blur', {{ bubbles: true }}));
+            return true;
+          }};
+          const steps = [];
+          if (!document.querySelector('#PPC_EPC_DC_I_Datum')) {{
+            return {{ ok: false, reason: 'need_KN', steps }};
+          }}
+          const radio = document.querySelector('#PPC_EPC_DC_I_Moznosti_1');
+          if (radio) {{ radio.checked = true; radio.click(); radio.dispatchEvent(new Event('change', {{ bubbles: true }})); steps.push('uvoz'); }}
+          if (setNative(document.querySelector('#PPC_EPC_DC_I_Datum'), dateVal)) steps.push('datum');
+          if (setNative(document.querySelector('#PPC_EPC_DC_I_Opis'), opisVal)) steps.push('opis');
+          const vp = document.querySelector('#PPC_EPC_DC_I_VrstaPrometa_h');
+          if (vp) {{ setNative(vp, 'KN'); steps.push('KN'); }}
+          const vt = document.querySelector('#PPC_EPC_DC_I_VrstaTemeljniceID_h');
+          if (vt) {{ setNative(vt, {json.dumps(VRSTA_ID)}); steps.push('vrsta_h'); }}
+          try {{
+            for (const inp of document.querySelectorAll('input.mm-select-input')) {{
+              const wrap = inp.closest('.input-group') || inp.parentElement;
+              const label = (wrap && wrap.previousElementSibling) ? (wrap.previousElementSibling.textContent || '') : '';
+              const blob = (label + ' ' + (inp.getAttribute('aria-label') || '')).toLowerCase();
+              if (/temeljnic|vrsta/.test(blob)) {{
+                setNative(inp, vrstaWant);
+                inp.dispatchEvent(new KeyboardEvent('keydown', {{ key: 'Enter', bubbles: true }}));
+                const opts = Array.from(document.querySelectorAll('li, .mm-select-item, [role=option]'));
+                const hit = opts.find(el => /izdani\\s*račun|\\bir\\b/i.test((el.innerText || '').trim()));
+                if (hit) try {{ hit.click(); }} catch (e) {{}}
+                steps.push('vrsta_ui');
+              }}
+            }}
+          }} catch (e) {{}}
+          return {{
+            ok: steps.includes('datum') || steps.includes('opis') || steps.includes('uvoz'),
+            steps,
+            date: (document.querySelector('#PPC_EPC_DC_I_Datum') || {{}}).value || '',
+            opis: (document.querySelector('#PPC_EPC_DC_I_Opis') || {{}}).value || '',
+            vrsta_id: (document.querySelector('#PPC_EPC_DC_I_VrstaTemeljniceID_h') || {{}}).value || ''
+          }};
+        }})()
+        """
+        result = self.eval(script)
+        return dict(result or {}) if isinstance(result, dict) else {"ok": False}
+
+    def click_import(self) -> Dict[str, Any]:
+        result = self.eval(
+            "(() => { const b=document.querySelector('#PPC_EPC_DC_B_Import'); "
+            "if(!b) return {ok:false}; b.click(); return {ok:true}; })()"
+        )
+        return dict(result or {}) if isinstance(result, dict) else {"ok": False}
+
+    def read_report(self) -> Dict[str, Any]:
+        script = r"""
+        (() => {
+          const showBtn = document.querySelector('#PPC_EPC_DC_A_PrikaziTemeljnico');
+          const table = document.querySelector('table.mm-table');
+          const rows = [];
+          let errors = 0;
+          if (table) {
+            for (const tr of table.querySelectorAll('tr')) {
+              const cells = Array.from(tr.querySelectorAll('th,td')).map(c => (c.innerText || '').trim());
+              if (cells.length >= 4) {
+                rows.push(cells);
+                const label = (cells[0] || '').toLowerCase();
+                if (/temeljnic|vrstica|ddv/.test(label)) {
+                  const n = parseInt(String(cells[3] || '0').replace(/\D/g, ''), 10);
+                  if (!isNaN(n)) errors += n;
+                }
+              }
+            }
+          }
+          const body = (document.body && document.body.innerText) || '';
+          const hasReport = /Poročilo o uvozu podatkov/i.test(body) || Boolean(showBtn);
+          return { ok: hasReport, has_report: hasReport, errors, rows, show_temeljnica: Boolean(showBtn) };
+        })()
+        """
+        result = self.eval(script)
+        return dict(result or {}) if isinstance(result, dict) else {"ok": False}
+
+    def click_show_temeljnica(self) -> Dict[str, Any]:
+        result = self.eval(
+            "(() => { const b=document.querySelector('#PPC_EPC_DC_A_PrikaziTemeljnico'); "
+            "if(!b) return {ok:false}; b.click(); return {ok:true}; })()"
+        )
+        return dict(result or {}) if isinstance(result, dict) else {"ok": False}
+
+    def import_knjizbe(self, payload: Dict[str, Any]) -> Dict[str, Any]:
+        xlsx = Path(str(payload.get("xlsx_path") or ""))
+        date_sl = str(payload.get("date_sl") or "")
+        opis = str(payload.get("opis") or "")
+        click_import = bool(payload.get("click_import", True))
+        open_temeljnica = bool(payload.get("open_temeljnica", True))
+        org_id = payload.get("organisation_id")
+        org_name = str(payload.get("organisation_name") or "").strip()
+        port = int(payload.get("remote_debugging_port") or self.remote_debugging_port)
+
+        if not xlsx.is_file():
+            raise FileNotFoundError(f"Excel ne obstaja: {xlsx}")
+        if not date_sl or not opis:
+            raise ValueError("Manjkata date_sl ali opis.")
+
+        snap = self.snapshot()
+        if not snap.get("logged_in"):
+            # Odpri Zacetek — uporabnik se prijavi enkrat v profil
+            self.navigate(MINIMAX_ZACETEK_URL)
+            snap = self.snapshot()
+        if not snap.get("logged_in"):
+            raise RuntimeError(
+                "WebView2 Minimax ni prijavljen.\n\n"
+                "Prijavi se v oknu WebView2 (seja se shrani v profil app-a), "
+                "nato ponovi uvoz — enkratna prijava."
+            )
+
+        # Video: najprej firma na Moje organizacije
+        org_sel = self.ensure_organisation(
+            organisation_id=int(org_id) if org_id else None,
+            organisation_name=org_name,
+        )
+        if not org_sel.get("ok") and (org_id or org_name):
+            raise RuntimeError(
+                f"Izbira firme ni uspela ({org_sel.get('how')}).\n"
+                f"Ročno klikni firmo v WebView2 (Moje organizacije) in ponovi."
+            )
+        if org_sel.get("ok"):
+            self.emit(f"firma: {org_sel.get('organisation') or org_name}")
+
+        url = MINIMAX_UVOZ_URL
+        if org_id:
+            url = f"{MINIMAX_UVOZ_URL}?OrganisationId={int(org_id)}"
+
+        self.emit(f"odpiram uvoz: {url}")
+        self.navigate(url)
+        snap = self.snapshot()
+
+        # Korak 1: Podatki → KN (razširi obrazec), nato fill
+        kn_steps: list = []
+        deadline = time.monotonic() + 28
+        form_ready = False
+        while time.monotonic() < deadline:
+            snap = self.snapshot()
+            if snap.get("has_uvoz_form"):
+                form_ready = True
+                break
+            sel = self.select_podatki_kn()
+            kn_steps.extend(list(sel.get("steps") or []))
+            if sel.get("has_form"):
+                form_ready = True
+                time.sleep(0.9)
+                break
+            time.sleep(0.5)
+        if not form_ready:
+            raise RuntimeError(
+                "Podatki → Knjižbe in DDV (KN) ni uspelo.\n"
+                "Ročno izberi KN v WebView2 oknu in ponovi, ali preveri prijavo."
+            )
+        self.emit(f"KN: {', '.join(str(s) for s in kn_steps) or 'OK'}")
+
+        filled: Dict[str, Any] = {}
+        deadline = time.monotonic() + 20
+        while time.monotonic() < deadline:
+            filled = self.fill_form(date_sl=date_sl, opis=opis)
+            if filled.get("ok"):
+                break
+            if filled.get("reason") == "need_KN":
+                self.select_podatki_kn()
+                time.sleep(0.8)
+                continue
+            time.sleep(0.4)
+        if not filled.get("ok"):
+            raise RuntimeError("Obrazec Uvoz podatkov ni pripravljen (Datum/Opis/IR).")
+
+        self.emit(f"vpisano: {', '.join(filled.get('steps') or [])}")
+        time.sleep(0.6)
+        try:
+            filled2 = self.fill_form(date_sl=date_sl, opis=opis)
+            if filled2.get("ok"):
+                filled = filled2
+        except Exception:
+            pass
+        filled["steps"] = list(kn_steps) + list(filled.get("steps") or [])
+
+        attached = _cdp_set_file_input(port, "#PPC_EPC_DC_FileUpload1", xlsx)
+        if not attached:
+            raise RuntimeError(
+                "Priponka Excela ni uspela (WebView2 CDP DOM.setFileInputFiles). "
+                f"Preveri remote-debugging-port={port} in websocket-client."
+            )
+        self.emit(f"datoteka pripetá: {xlsx.name}")
+
+        report: Dict[str, Any] = {}
+        if click_import:
+            clicked = self.click_import()
+            if not clicked.get("ok"):
+                raise RuntimeError("Gumb Uvozi podatke ni najden.")
+            self.emit("klik Uvozi podatke …")
+            deadline = time.monotonic() + 60
+            while time.monotonic() < deadline:
+                report = self.read_report()
+                if report.get("has_report"):
+                    break
+                time.sleep(0.5)
+            if not report.get("has_report"):
+                raise TimeoutError("Poročilo o uvozu se ni prikazalo.")
+            errors = int(report.get("errors") or 0)
+            if errors > 0:
+                raise RuntimeError(f"Uvoz z napakami ({errors}).")
+            if open_temeljnica and report.get("show_temeljnica"):
+                self.click_show_temeljnica()
+                report["opened_temeljnica"] = True
+                self.emit("odprta temeljnica")
+
+        return {
+            "ok": True,
+            "steps": list(filled.get("steps") or []) + (["datoteka", "uvozi"] if click_import else ["datoteka"]),
+            "date": date_sl,
+            "opis": opis,
+            "file": xlsx.name,
+            "organisation": snap.get("organisation") or "",
+            "report": report,
+            "source": "WebView2",
+        }
+
+    def handle(self, action: str, payload: Dict[str, Any]) -> Dict[str, Any]:
+        if action == "diagnose":
+            return self.snapshot()
+        if action == "navigate_uvoz":
+            url = str(payload.get("url") or MINIMAX_UVOZ_URL)
+            self.navigate(url)
+            return self.snapshot()
+        if action == "reload":
+            self.eval("location.reload(); true")
+            self.wait_ready_state(15)
+            return self.snapshot()
+        if action == "import_knjizbe":
+            return self.import_knjizbe(payload)
+        if action == "shutdown":
+            self.stop_event.set()
+            try:
+                self.window.destroy()
+            except Exception:
+                pass
+            return {"stopped": True}
+        raise ValueError(f"Neznan WebView2 ukaz: {action}")
+
+    def respond(self, request_id: str, ok: bool, result=None, error: str = "") -> None:
+        target = self.responses_dir / f"{request_id}.json"
+        tmp = target.with_suffix(".tmp")
+        data = {"ok": bool(ok), "result": result or {}, "error": error}
+        tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
+        tmp.replace(target)
+
+    def command_loop(self) -> None:
+        self.emit("IPC ukazna zanka pripravljena.")
+        while not self.stop_event.is_set():
+            for p in sorted(self.commands_dir.glob("*.json")):
+                request_id = p.stem
+                try:
+                    data = json.loads(p.read_text(encoding="utf-8"))
+                    request_id = str(data.get("id") or p.stem)
+                    action = str(data.get("action") or "")
+                    payload = dict(data.get("payload") or {})
+                    p.unlink(missing_ok=True)
+                    self.emit(f"ukaz: {action}")
+                    result = self.handle(action, payload)
+                    self.respond(request_id, True, result=result)
+                except Exception as exc:
+                    try:
+                        p.unlink(missing_ok=True)
+                    except Exception:
+                        pass
+                    self.emit(f"ukaz ni uspel: {exc}", "ERROR")
+                    self.respond(str(request_id), False, error=str(exc))
+            time.sleep(0.10)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ipc-dir", required=True)
+    parser.add_argument("--profile-dir", required=True)
+    parser.add_argument("--download-dir", required=True)
+    parser.add_argument("--remote-debugging-port", type=int, default=9333)
+    parser.add_argument("--start-url", default=MINIMAX_UVOZ_URL)
+    args = parser.parse_args()
+
+    os.environ["WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS"] = (
+        f"--remote-debugging-port={int(args.remote_debugging_port)}"
+    )
+
+    host = Host(
+        Path(args.ipc_dir),
+        Path(args.profile_dir),
+        Path(args.download_dir),
+        remote_debugging_port=int(args.remote_debugging_port),
+        start_url=str(args.start_url),
+    )
+    title = f"Davčna Blagajna — Minimax Uvoz WebView2 [{os.getpid()}]"
+    try:
+        import webview
+
+        webview.settings["ALLOW_DOWNLOADS"] = True
+        webview.settings["OPEN_EXTERNAL_LINKS_IN_BROWSER"] = False
+        webview.settings["OPEN_DEVTOOLS_IN_DEBUG"] = False
+        window = webview.create_window(
+            title,
+            host.start_url,
+            width=1180,
+            height=760,
+            resizable=True,
+            min_size=(700, 480),
+            confirm_close=False,
+        )
+        host.window = window
+        window.events.before_show += host.before_show
+        window.events.shown += host.shown
+        window.events.loaded += host.loaded
+        host.write_state(
+            ready=False,
+            hwnd=0,
+            renderer="EdgeChromium / WebView2",
+            message="Inicializacija WebView2",
+        )
+        webview.start(
+            gui="edgechromium",
+            debug=False,
+            private_mode=False,
+            storage_path=str(host.profile_dir),
+        )
+        return 0
+    except Exception as exc:
+        host.write_state(ready=False, hwnd=0, fatal=f"WebView2 ni mogoče zagnati: {exc}")
+        host.emit("FATAL: " + str(exc), "ERROR")
+        try:
+            (host.ipc_dir / "host_error.log").write_text(traceback.format_exc(), encoding="utf-8")
+        except Exception:
+            pass
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
