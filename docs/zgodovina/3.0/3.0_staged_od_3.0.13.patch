@@ -0,0 +1,737 @@
+"""Standalone WebView2 host for Minimax Uvoz podatkov (Knjižbe in DDV).
+
+Ločen od FURS Chrome. Selektorji iz Hitri zajem 2026-10-08.
+"""
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import os
+import threading
+import time
+import traceback
+import urllib.request
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+MINIMAX_UVOZ_URL = "https://moj.minimax.si/SI/VA/WebUI/UvozPodatkov/UvozPodatkovCSV.aspx"
+MINIMAX_ZACETEK_URL = "https://moj.minimax.si/SI/VA/WebUI/Zacetek/Zacetek.aspx"
+VRSTA_ID = "2"
+VRSTA_LABEL = "IR - Izdani račun"
+TIP_LABEL = "Knjižbe in DDV"
+
+
+def _http_json(url: str, timeout: float = 3.0) -> Any:
+    with urllib.request.urlopen(url, timeout=timeout) as resp:
+        return json.loads(resp.read().decode("utf-8", errors="replace"))
+
+
+def _cdp_ws_send(ws_url: str, method: str, params: Optional[dict] = None, timeout_sec: float = 10.0) -> Any:
+    """Minimal CDP over websocket (stdlib-only fallback via temporary helper)."""
+    try:
+        import websocket  # type: ignore
+    except Exception as exc:
+        raise RuntimeError(
+            "Za priponko datoteke v WebView2 potrebuješ paket websocket-client "
+            f"(pip install websocket-client). {exc}"
+        ) from exc
+
+    ws = websocket.create_connection(ws_url, timeout=timeout_sec)
+    try:
+        msg_id = int(time.time() * 1000) % 1_000_000_000
+        ws.send(json.dumps({"id": msg_id, "method": method, "params": params or {}}))
+        deadline = time.time() + timeout_sec
+        while time.time() < deadline:
+            raw = ws.recv()
+            data = json.loads(raw)
+            if data.get("id") == msg_id:
+                if "error" in data:
+                    raise RuntimeError(str(data["error"]))
+                return data.get("result")
+        raise TimeoutError(f"CDP timeout: {method}")
+    finally:
+        try:
+            ws.close()
+        except Exception:
+            pass
+
+
+def _cdp_set_file_input(debug_port: int, selector: str, file_path: Path) -> bool:
+    path = str(Path(file_path).resolve())
+    if not Path(path).is_file():
+        return False
+    try:
+        pages = _http_json(f"http://127.0.0.1:{int(debug_port)}/json")
+    except Exception:
+        return False
+    ws_url = ""
+    for row in pages or []:
+        u = str(row.get("url") or "")
+        if "UvozPodatkov" in u or "minimax" in u.lower():
+            ws_url = str(row.get("webSocketDebuggerUrl") or "").strip()
+            if ws_url:
+                break
+    if not ws_url and pages:
+        ws_url = str((pages[0] or {}).get("webSocketDebuggerUrl") or "").strip()
+    if not ws_url:
+        return False
+    try:
+        _cdp_ws_send(ws_url, "DOM.enable", {})
+        doc = _cdp_ws_send(ws_url, "DOM.getDocument", {"depth": 1})
+        root_id = ((doc or {}).get("root") or {}).get("nodeId")
+        if not root_id:
+            return False
+        q = _cdp_ws_send(ws_url, "DOM.querySelector", {"nodeId": int(root_id), "selector": selector})
+        node_id = (q or {}).get("nodeId")
+        if not node_id:
+            return False
+        _cdp_ws_send(ws_url, "DOM.setFileInputFiles", {"nodeId": int(node_id), "files": [path]})
+        return True
+    except Exception:
+        return False
+
+
+class Host:
+    def __init__(
+        self,
+        ipc_dir: Path,
+        profile_dir: Path,
+        download_dir: Path,
+        *,
+        remote_debugging_port: int = 9333,
+        start_url: str = MINIMAX_UVOZ_URL,
+    ):
+        self.ipc_dir = ipc_dir
+        self.profile_dir = profile_dir
+        self.download_dir = download_dir
+        self.remote_debugging_port = int(remote_debugging_port)
+        self.start_url = start_url or MINIMAX_UVOZ_URL
+        self.commands_dir = ipc_dir / "commands"
+        self.responses_dir = ipc_dir / "responses"
+        self.state_file = ipc_dir / "state.json"
+        self.events_file = ipc_dir / "events.jsonl"
+        self.window = None
+        self.ready = threading.Event()
+        self.stop_event = threading.Event()
+        self.hwnd = 0
+        for p in (self.ipc_dir, self.profile_dir, self.download_dir, self.commands_dir, self.responses_dir):
+            p.mkdir(parents=True, exist_ok=True)
+
+    def emit(self, message: str, level: str = "INFO") -> None:
+        item = {
+            "time": datetime.now().strftime("%H:%M:%S"),
+            "level": level,
+            "message": str(message),
+        }
+        try:
+            with self.events_file.open("a", encoding="utf-8") as f:
+                f.write(json.dumps(item, ensure_ascii=False) + "\n")
+        except Exception:
+            pass
+
+    def write_state(self, **updates) -> None:
+        state: Dict[str, Any] = {}
+        try:
+            if self.state_file.exists():
+                state = json.loads(self.state_file.read_text(encoding="utf-8"))
+        except Exception:
+            state = {}
+        state.update(updates)
+        state["pid"] = os.getpid()
+        state["remote_debugging_port"] = self.remote_debugging_port
+        tmp = self.state_file.with_suffix(".tmp")
+        try:
+            tmp.write_text(json.dumps(state, ensure_ascii=False), encoding="utf-8")
+            tmp.replace(self.state_file)
+        except Exception:
+            pass
+
+    def _find_hwnd(self, title: str) -> int:
+        if os.name != "nt":
+            return 0
+        try:
+            return int(ctypes.windll.user32.FindWindowW(None, title) or 0)
+        except Exception:
+            return 0
+
+    def before_show(self, window) -> None:
+        self.window = window
+        self.emit("native WebView2 control inicializiran.")
+
+    def shown(self, window) -> None:
+        self.window = window
+        title = str(getattr(window, "title", "Davčna Blagajna — Minimax Uvoz WebView2"))
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline and not self.hwnd:
+            self.hwnd = self._find_hwnd(title)
+            if not self.hwnd:
+                time.sleep(0.05)
+        self.ready.set()
+        self.write_state(
+            ready=True,
+            hwnd=self.hwnd,
+            renderer="EdgeChromium / WebView2",
+            profile=str(self.profile_dir),
+            message="WebView2 pripravljen",
+        )
+        self.emit(f"WebView2 pripravljen; CDP :{self.remote_debugging_port}; profil={self.profile_dir}")
+        threading.Thread(target=self.command_loop, daemon=True, name="WebView2IPC").start()
+
+    def loaded(self, window) -> None:
+        self.window = window
+
+    def eval(self, script: str):
+        if not self.window:
+            raise RuntimeError("WebView2 okno še ni pripravljeno.")
+        return self.window.evaluate_js(script)
+
+    def wait_ready_state(self, timeout: float = 15.0) -> None:
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            try:
+                state = self.eval("document.readyState")
+                if str(state) in ("interactive", "complete"):
+                    return
+            except Exception:
+                pass
+            time.sleep(0.15)
+
+    def navigate(self, url: str) -> None:
+        self.window.load_url(url)
+        self.wait_ready_state(20)
+        time.sleep(0.4)
+
+    def snapshot(self) -> Dict[str, Any]:
+        script = r"""
+        (() => {
+          const n = s => (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'')
+             .replace(/\s+/g,' ').trim().toUpperCase();
+          let org='';
+          for (const e of document.querySelectorAll('ul.mm-menu > li > span.mm-header-dropdown > a, a[href*="ZacetekOrganizacije.aspx"]')) {
+            const t=(e.innerText || e.textContent || '').replace(/\s+/g,' ').trim();
+            if (t) { org=t; break; }
+          }
+          const body=(document.body?.innerText || '').slice(0,12000);
+          const bn=n(body);
+          const href=location.href || '';
+          const login = bn.includes('PRIJAVA') && (href.toUpperCase().includes('LOGIN') || href.toUpperCase().includes('ACCOUNT'));
+          return {
+            url: href,
+            title: document.title || '',
+            organisation: org,
+            logged_in: !login,
+            has_uvoz_form: Boolean(document.querySelector('#PPC_EPC_DC_I_Datum')),
+            has_report: /POROCILO O UVOZU/i.test(bn) || Boolean(document.querySelector('#PPC_EPC_DC_A_PrikaziTemeljnico'))
+          };
+        })()
+        """
+        result = self.eval(script)
+        return dict(result or {}) if isinstance(result, dict) else {}
+
+    def ensure_organisation(self, *, organisation_id: Optional[int], organisation_name: str = "") -> Dict[str, Any]:
+        """Hitri korak: Moje organizacije → klik firme (kot video), nato uvoz."""
+        oid = int(organisation_id) if organisation_id else 0
+        onm = (organisation_name or "").strip()
+        snap = self.snapshot()
+        org_now = str(snap.get("organisation") or "").strip()
+        if org_now and onm:
+            key = onm.split()[0].lower()
+            if key and key in org_now.lower():
+                return {"ok": True, "how": "already", "organisation": org_now}
+
+        self.emit(f"izbiram firmo: {onm or oid}")
+        self.navigate(MINIMAX_ZACETEK_URL)
+        time.sleep(0.6)
+        script = f"""
+        (() => {{
+          const oid = {json.dumps(str(oid) if oid else "")};
+          const onm = {json.dumps(onm.lower())};
+          const norm = (s) => String(s || '')
+            .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')
+            .replace(/\\s+/g, ' ').trim().toLowerCase();
+          const want = norm(onm);
+          const fire = (el) => {{
+            if (!el) return false;
+            try {{ el.click(); return true; }} catch (e) {{}}
+            try {{
+              el.dispatchEvent(new MouseEvent('click', {{ bubbles: true, cancelable: true, view: window }}));
+              return true;
+            }} catch (e) {{}}
+            return false;
+          }};
+          try {{
+            const search = document.querySelector('#F_Search, input[placeholder*="Poišči"], input[type=search]');
+            if (search && want) {{
+              const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
+              if (setter) setter.call(search, want.split(' ')[0] || want); else search.value = want.split(' ')[0] || want;
+              search.dispatchEvent(new Event('input', {{ bubbles: true }}));
+              search.dispatchEvent(new Event('keyup', {{ bubbles: true }}));
+            }}
+          }} catch (e) {{}}
+          const anchors = Array.from(document.querySelectorAll('a.organizacija-naziv, a[id$="LinkButton1"], a'));
+          if (want && want.length > 2) {{
+            const aExact = anchors.find(a => norm(a.textContent) === want);
+            if (aExact && fire(aExact)) return {{ ok: true, how: 'name', text: (aExact.innerText||'').trim() }};
+            const aPart = anchors.find(a => {{
+              const t = norm(a.textContent);
+              return t.includes(want) && t.length < want.length + 40;
+            }});
+            if (aPart && fire(aPart)) return {{ ok: true, how: 'name_part', text: (aPart.innerText||'').trim() }};
+            const key = want.split(/[,\\s]+/).filter(Boolean).slice(0, 2).join(' ');
+            if (key) {{
