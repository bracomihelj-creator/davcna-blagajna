+def _minimax_knjizenje_fill_search_js(
+    *,
+    date_from_sl: str,
+    date_to_sl: str,
+    opis: str = "",
+) -> str:
+    """Hitri zajem 2026-10-11: DatumOd/Do + Najdi na KnjizenjeIzdanegaRacuna.aspx."""
+    d0 = json.dumps(str(date_from_sl or "").strip())
+    d1 = json.dumps(str(date_to_sl or "").strip())
+    op = json.dumps(str(opis or "").strip())
+    return f"""
+(() => {{
+  const setVal = (sel, v) => {{
+    const el = document.querySelector(sel);
+    if (!el) return false;
+    el.focus();
+    el.value = String(v || '');
+    el.dispatchEvent(new Event('input', {{ bubbles: true }}));
+    el.dispatchEvent(new Event('change', {{ bubbles: true }}));
+    el.dispatchEvent(new Event('blur', {{ bubbles: true }}));
+    return true;
+  }};
+  const odOk = setVal('#PPC_ctl04_ctl00_ctl01_I_DatumOd', {d0});
+  const doOk = setVal('#PPC_ctl04_ctl00_ctl01_I_DatumDo', {d1});
+  const opis = {op};
+  let opisOk = true;
+  if (opis) opisOk = setVal('#PPC_ctl04_ctl00_ctl01_I_Opis', opis);
+  const btn = document.querySelector('#PPC_ctl04_ctl00_B_Search, button#PPC_ctl04_ctl00_B_Search');
+  let clicked = false;
+  if (btn) {{
+    try {{ btn.click(); clicked = true; }} catch (e) {{
+      try {{
+        btn.dispatchEvent(new MouseEvent('click', {{ bubbles: true, cancelable: true, view: window }}));
+        clicked = true;
+      }} catch (e2) {{}}
+    }}
+  }}
+  // Hitri zajem (prava firma): rezultati v #TSearchFrame tudi brez Datum Od/Do —
+  // Najdi je dovolj, če smo v pravi org (navbar Eko-romatika…).
+  const tbl = document.querySelector('#TSearchFrame');
+  const rows = tbl ? tbl.querySelectorAll('tr').length : 0;
+  const nav = String(document.body ? document.body.innerText : '').slice(0, 800);
+  return {{
+    ok: !!(clicked || (odOk && doOk)),
+    odOk, doOk, opisOk, clicked,
+    tableRows: rows,
+    title: String(document.title || ''),
+    path: String(location.pathname || ''),
+    navSample: nav,
