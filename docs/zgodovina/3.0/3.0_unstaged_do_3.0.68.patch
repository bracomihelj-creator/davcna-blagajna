+def _minimax_find_org_select_tab(
+    endpoints: List[Tuple[str, int]],
+    *,
+    organisation_name: str = "",
+) -> Optional[Tuple[str, int, Dict[str, Any], str]]:
+    """Preferiraj firmo / Moje org pred peach Vstopite (samo podani endpoints = :9223)."""
+    org_key = (organisation_name or "").strip().lower()
+    org_parts = [p for p in re.split(r"[,.\s]+", org_key) if len(p) >= 3][:2]
+    best: Optional[Tuple[int, str, int, Dict[str, Any], str]] = None
+    for host, port in endpoints:
+        for row in _chrome_cdp_list_pages(host, port):
+            if str(row.get("type") or "").lower() not in ("", "page"):
+                continue
+            u = str(row.get("url") or "").lower()
+            title = str(row.get("title") or "").lower()
+            if "moj.minimax.si" not in u:
+                continue
+            ws = str(row.get("webSocketDebuggerUrl") or "").strip()
+            if not ws:
+                continue
+            score = 10
+            if "zacetekorganizacije" in u:
+                score = 100
+            elif org_parts and all(p in title or p in u for p in org_parts):
+                score = 90
+            elif "zacetek/zacetek.aspx" in u and "organizacije" not in u:
+                score = 80
+            elif "uvozpodatkov" in u:
+                score = 70
+            elif _minimax_is_vstopite_landing_url(u):
+                score = 4
+            cand = (score, host, int(port), row, ws)
+            if best is None or cand[0] > best[0]:
+                best = cand
+    if best is None:
+        return None
+    return best[1], best[2], best[3], best[4]
+
