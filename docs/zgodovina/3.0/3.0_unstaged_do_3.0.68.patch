+def _find_open_dialog_hwnd() -> int:
+    """Najdi HWND Windows Open/Odpri dialoga."""
+    if os.name != "nt":
+        return 0
+    user32 = ctypes.windll.user32
+    found = ctypes.c_void_p(0)
+    titles = (
+        "Open",
+        "Odpri",
+        "Izberi datoteko",
