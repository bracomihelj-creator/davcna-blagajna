+    for host, port in endpoints:
+        for row in _chrome_cdp_list_pages(host, port):
+            if str(row.get("type") or "").lower() not in ("", "page"):
+                continue
+            u = str(row.get("url") or "").lower()
+            title = str(row.get("title") or "").lower()
+            if "moj.minimax.si" not in u and "minimax" not in title:
+                continue
+            if not str(row.get("webSocketDebuggerUrl") or "").strip():
+                continue
+            score = 10
+            if "uvozpodatkov" in u:
+                score = 100
+            elif "knjizenjeizdanegaracuna" in u or (
+                "knjizenje" in u and "izdan" in u
