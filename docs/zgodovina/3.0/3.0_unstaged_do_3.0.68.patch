+def open_minimax_knjizenje_after_api(
+    *,
+    organisation_id: Optional[int],
+    yyyy: str,
+    mm: str,
+    date_from_sl: Optional[str] = None,
+    date_to_sl: Optional[str] = None,
+    opis: str = "",
+    organisation_name: str = "",
+) -> str:
+    """Po API: pregled Knjiženja v samostojnem WebView2 (video OdpriKnjiženje).
+
+    HARD Moje org → naziv firme → Knjiženje IR/iztržkov → Najdi (Od/Do).
+    Brez Chrome vtičnika / Bridge. Uvoz KN WebView2 (3.0.42) ostane nespremenjen.
+    """
+    oid = int(organisation_id) if organisation_id and int(organisation_id) > 0 else 0
+    org_name = (organisation_name or "").strip()
+    if not org_name and oid:
+        org_name = (lookup_minimax_org_name(oid) or "").strip()
+    url = minimax_web_knjizenje_url(oid if oid else None)
+    try:
+        mm_i = int(str(mm).strip())
+        yyyy_s = str(yyyy).strip()
+        d0 = (date_from_sl or "").strip() or f"01.{mm_i:02d}.{yyyy_s}"
+        d1 = (date_to_sl or "").strip() or last_day_of_month_sl(yyyy_s, f"{mm_i:02d}")
+    except (TypeError, ValueError):
+        d0 = (date_from_sl or "").strip()
+        d1 = (date_to_sl or "").strip()
+
+    def _work() -> None:
+        try:
+            from v2.minimax_uvoz_config import load_minimax_uvoz_config
+            from v2.minimax_webview2 import MinimaxUvozWebView2Controller, WebView2Unavailable
+            from v2.version_journal import APP_ROOT
+
+            cfg = load_minimax_uvoz_config()
+            port = int(cfg.get("remote_debugging_port") or 9333)
+            login_user, login_pass = "", ""
+            try:
+                login_user, login_pass = load_minimax_web_login_credentials_from_settings()
+            except Exception:
+                login_user, login_pass = "", ""
+
+            def _log(m: str) -> None:
+                log_info(f"open_minimax_knjizenje_after_api | {m}")
+
+            ctrl = MinimaxUvozWebView2Controller(APP_ROOT)
+            result = ctrl.open_knjizenje(
+                organisation_id=oid if oid else None,
+                organisation_name=org_name,
+                date_from=d0 or "",
+                date_to=d1 or "",
+                opis=str(opis or "").strip(),
+                remote_debugging_port=port,
+                start_url=MINIMAX_WEB_ZACETEK_URL,
+                login_username=login_user or "",
+                login_password=login_pass or "",
+                log=_log,
+            )
+            log_info(
+                f"open_minimax_knjizenje_after_api | WebView2 OK | "
+                f"org={result.get('organisation') or org_name} | "
+                f"{d0}–{d1} | najdi={((result.get('najdi') or {}).get('ok'))} | {url}"
+            )
+        except Exception as exc:
+            # WebView2Unavailable / Timeout / Runtime — log, ne zruši API uspeha
+            try:
+                from v2.minimax_webview2 import WebView2Unavailable
+
+                if isinstance(exc, WebView2Unavailable):
+                    log_error("open_minimax_knjizenje_after_api WebView2", exc)
+                else:
+                    log_error("open_minimax_knjizenje_after_api", exc)
+            except Exception:
+                log_error("open_minimax_knjizenje_after_api", exc)
+
+    threading.Thread(
+        target=_work, daemon=True, name="MinimaxKnjizenjeAfterApi"
+    ).start()
+    log_info(
+        f"open_minimax_knjizenje_after_api | start WebView2 | org={oid or '-'} | "
+        f"{org_name or '-'} | {d0 or '?'}–{d1 or '?'} | {url}"
+    )
+    return url
+
