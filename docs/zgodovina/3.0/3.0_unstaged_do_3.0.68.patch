+def _minimax_knjizenje_cdp_fill_search(
+    *,
+    date_from_sl: str,
+    date_to_sl: str,
+    opis: str = "",
+    wait_sec: float = 8.0,
+) -> Tuple[bool, str]:
+    """V že odprtem Minimax Chrome/Edge (:9223) vpiši obdobje in klikni Najdi."""
+    js = _minimax_knjizenje_fill_search_js(
+        date_from_sl=date_from_sl, date_to_sl=date_to_sl, opis=opis
+    )
+    deadline = time.time() + max(2.0, float(wait_sec))
+    last_err = "ni zavihka Knjiženje"
+    while time.time() < deadline:
+        found = None
+        for host, port in _minimax_cdp_iter_endpoints():
+            for row in _chrome_cdp_list_pages(host, int(port)):
+                if str(row.get("type") or "").lower() not in ("", "page"):
+                    continue
+                page_url = str(row.get("url") or "").lower()
+                title = str(row.get("title") or "").lower()
+                if "knjizenjeizdanegaracuna" not in page_url.replace("%", ""):
+                    if "knjizenje" not in page_url and "izdanih" not in title:
+                        continue
+                ws = str(row.get("webSocketDebuggerUrl") or "").strip()
+                if not ws:
+                    continue
+                found = (host, int(port), row, ws)
+                break
+            if found:
+                break
+        if not found:
+            time.sleep(0.4)
+            continue
+        host, port, page, ws = found
+        try:
+            _chrome_cdp_activate_page(host, port, page)
+            result = _chrome_cdp_runtime_evaluate(ws, js, timeout_sec=10.0) or {}
+            if isinstance(result, dict) and result.get("ok"):
+                log_info(
+                    f"_minimax_knjizenje_cdp_fill_search | OK | {date_from_sl}–{date_to_sl} | "
+                    f"{host}:{port}"
+                )
+                return True, "OK — Datum Od/Do + Najdi"
+            last_err = f"fill partial: {result!r}"
+        except Exception as exc:
+            last_err = str(exc)
+            log_error("_minimax_knjizenje_cdp_fill_search", exc)
+        time.sleep(0.5)
+    return False, last_err
+
