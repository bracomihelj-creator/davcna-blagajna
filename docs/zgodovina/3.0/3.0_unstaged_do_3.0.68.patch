+def _minimax_session_navigate_knjizenje(
+    url: str,
+    *,
+    organisation_name: str = "",
+) -> Tuple[bool, str]:
+    """V OBSTOJEČI Minimax CDP seji navigiraj na Knjiženje — brez novega zavihka."""
+    found = _minimax_pick_best_session_tab(organisation_name=organisation_name)
+    if not found:
+        return False, "ni obstoječega Minimax zavihka"
+    h, p, page = found
+    page, ws = _minimax_refresh_page_ws(h, int(p), page)
+    if not ws:
+        return False, "ni websocket na obstoječem zavihku"
+    u = str((page or {}).get("url") or "").lower()
+    _chrome_cdp_activate_page(h, int(p), page or {})
+    if "knjizenjeizdanegaracuna" in u or (
+        "knjizenje" in u and "izdan" in u
+    ):
+        return True, f"reuse_existing_tab :{p}"
+    try:
+        _chrome_cdp_navigate(ws, url, timeout_sec=18.0)
+        time.sleep(1.1)
+        return True, f"navigate_existing_tab :{p}"
+    except Exception as exc:
+        log_error("_minimax_session_navigate_knjizenje", exc)
+        return False, str(exc)
