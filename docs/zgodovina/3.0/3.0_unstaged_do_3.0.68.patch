+                # Že odprt Knjiženje izdanih — ista prijavljena seja
+                score = 98
+            elif "zacetekorganizacije" in u:
+                score = 90
+            elif org_parts and all(p in title or p in u for p in org_parts):
+                score = 85
+            elif "zacetek.aspx" in u and "organizacije" not in u:
