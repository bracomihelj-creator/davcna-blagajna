+def _minimax_uvoz_find_page_ws(
+    endpoints: List[Tuple[str, int]],
+    *,
+    needles: Optional[Sequence[str]] = None,
+) -> Optional[Tuple[str, int, Dict[str, Any], str]]:
+    want = [n.lower() for n in (needles or ("uvozpodatkov", "uvoz"))]
+    for host, port in endpoints:
+        for row in _chrome_cdp_list_pages(host, port):
+            u = str(row.get("url") or "").lower()
+            if any(n in u for n in want):
+                ws = str(row.get("webSocketDebuggerUrl") or "").strip()
+                if ws:
+                    return host, port, row, ws
+    return None
+
