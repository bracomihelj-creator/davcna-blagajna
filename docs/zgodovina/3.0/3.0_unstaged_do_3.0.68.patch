+def _minimax_knjizenje_verify_js(organisation_name: str = "") -> str:
+    """Preveri navbar firmo + vrstice v #TSearchFrame (ciljni zajem Eko-romatika)."""
+    onm = json.dumps(str(organisation_name or "").strip().lower())
+    return f"""
+(() => {{
+  const norm = (s) => String(s || '')
+    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')
+    .replace(/\\s+/g, ' ').trim().toLowerCase();
+  const want = norm({onm});
+  const body = norm(document.body ? document.body.innerText : '');
+  const navLink = document.querySelector(
+    'ul.mm-menu a[href*="ZacetekOrganizacije"], span.mm-header-dropdown a, a[href*="ZacetekOrganizacije"]'
+  );
+  const navText = norm(navLink ? navLink.innerText : '');
+  const firmOk = !want || navText.includes(want) || body.includes(want);
+  const tbl = document.querySelector('#TSearchFrame');
+  const rows = tbl ? Array.from(tbl.querySelectorAll('tr')).map(tr =>
+    Array.from(tr.querySelectorAll('th,td')).map(c => (c.innerText || '').trim()).filter(Boolean)
+  ).filter(r => r.length) : [];
+  const hasData = rows.some(r => r.some(c => /blagajna|iztr|\\d{{1,2}}\\.\\d{{1,2}}\\.\\d{{4}}/i.test(c)));
+  return {{
+    ok: !!(firmOk && (hasData || rows.length > 1)),
+    firmOk, hasData,
+    navText: (navLink && navLink.innerText || '').trim().slice(0, 80),
+    rowCount: rows.length,
+    sample: rows.slice(0, 4),
+  }};
+}})()
