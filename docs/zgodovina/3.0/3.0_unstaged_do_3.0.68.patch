+def _furs_kirkpr_period_fill_js(
+    period_from_sl: str, period_to_sl: str, *, click_isci: bool = True
+) -> str:
+    """JS: Obdobje od/do + Išči na DDV_Evidenci_Oddane (kot MRN/FURS Od/do)."""
+    from_js = json.dumps(period_from_sl)
+    to_js = json.dumps(period_to_sl)
+    click_js = json.dumps(bool(click_isci))
+    return f"""
+(() => {{
+  const fromWant = {from_js};
+  const toWant = {to_js};
+  const clickFind = {click_js};
+  const setNative = (el, val) => {{
+    if (!el) return false;
+    try {{ el.focus(); }} catch (e) {{}}
+    try {{
+      const desc = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
+      if (desc && desc.set) desc.set.call(el, val); else el.value = val;
+    }} catch (e) {{ el.value = val; }}
+    el.dispatchEvent(new Event('input', {{ bubbles: true }}));
+    el.dispatchEvent(new Event('change', {{ bubbles: true }}));
+    el.dispatchEvent(new Event('blur', {{ bubbles: true }}));
+    return true;
+  }};
+  const inpFrom = document.querySelector(
+    '#OpenMainContent_MainContent_txtPeriodFrom, input[id*="txtPeriodFrom"], input[name*="PeriodFrom"]'
+  );
+  const inpTo = document.querySelector(
+    '#OpenMainContent_MainContent_txtPeriodTo, input[id*="txtPeriodTo"], input[name*="PeriodTo"]'
+  );
+  if (!inpFrom || !inpTo) {{
+    return {{ ok: false, how: 'no_fields', path: location.pathname || '', title: document.title || '' }};
+  }}
+  setNative(inpFrom, fromWant);
+  setNative(inpTo, toWant);
+  let isci = false;
+  if (clickFind) {{
+    const btn = document.querySelector(
+      '#OpenMainContent_MainContent_btnFind, input[id*="btnFind"], button[id*="btnFind"]'
+    );
+    if (btn) {{
+      try {{ btn.click(); isci = true; }} catch (e) {{
+        try {{
+          btn.dispatchEvent(new MouseEvent('click', {{ bubbles: true, cancelable: true, view: window }}));
+          isci = true;
+        }} catch (e2) {{}}
+      }}
+    }}
+  }}
+  return {{
+    ok: true,
+    how: isci ? 'filled_isci' : 'filled',
+    from: String(inpFrom.value || ''),
+    to: String(inpTo.value || ''),
+    path: location.pathname || ''
+  }};
+}})()
+""".strip()
+
+
+def furs_kirkpr_cdp_fill_period(
+    yyyy: str,
+    mm: str,
+    *,
+    page_url: str = "",
+    wait_page_sec: float = 22.0,
+    click_isci: bool = True,
+) -> Tuple[bool, str]:
+    """V že odprtem Chrome (CDP) vpiši Obdobje od/do na KIR/KPR eDavki + Išči."""
+    period_from, period_to = furs_ddv_period_sl_first_last_day(yyyy, mm)
+    js = _furs_kirkpr_period_fill_js(period_from, period_to, click_isci=click_isci)
+    deadline = time.time() + max(8.0, float(wait_page_sec))
+    last_err = "ni zavihka DDV_Evidenci"
+    _ = page_url
+    while time.time() < deadline:
+        found = _chrome_cdp_find_page(
+            "DDV_Evidenci",
+            prefer_title="evidenc",
+            extra_needles=("edavki.durs.si", "Evidenci", "obračunanega", "obracunanega"),
+        )
+        if found is None:
+            found = _chrome_cdp_find_page(
+                "edavki.durs.si",
+                prefer_title="ddv",
+                extra_needles=("Evidenc", "PeriodFrom", "btnFind"),
+            )
+        if found is None:
+            time.sleep(0.45)
+            continue
+        host, port, page = found
+        ws = str(page.get("webSocketDebuggerUrl") or "").strip()
+        if not ws:
+            time.sleep(0.3)
+            continue
+        try:
+            _chrome_cdp_activate_page(host, port, page)
+            result = _chrome_cdp_runtime_evaluate(ws, js, timeout_sec=12.0)
+            if isinstance(result, dict) and result.get("ok"):
+                msg = (
+                    f"Vpisano Obdobje {result.get('from') or period_from}"
+                    f" – {result.get('to') or period_to}"
+                )
+                if result.get("how") == "filled_isci":
+                    msg += " + Išči"
+                log_info(f"furs_kirkpr_cdp_fill | {msg} | {host}:{port}")
+                return True, msg
+            last_err = str((result or {}).get("how") or result or "fill_failed")
+        except Exception as exc:
+            last_err = str(exc)
+            log_error("furs_kirkpr_cdp_fill", exc)
+        time.sleep(0.5)
+    return False, (
+        f"CDP ni vpisal Obdobje od/do ({period_from} – {period_to}).\n"
+        f"Vzrok: {last_err}\n\n"
+        "Odpri eDavki v Chrome (debug :9222), prijavi se, nato ponovi\n"
+        "Prenos KIR/KPR eDavki."
+    )
+
+
+def furs_kirkpr_cdp_fill_period_threaded(
+    *,
+    on_done: Optional[Callable[[bool, str], None]] = None,
+    **kwargs: Any,
+) -> None:
+    def work() -> None:
+        ok, msg = False, ""
+        try:
+            ok, msg = furs_kirkpr_cdp_fill_period(**kwargs)
+        except Exception as exc:
+            ok, msg = False, str(exc)
+            log_error("furs_kirkpr_cdp_fill_period_threaded", exc)
+        if on_done is not None:
+            try:
+                on_done(ok, msg)
+            except Exception as exc2:
+                log_error("furs_kirkpr_cdp_fill on_done", exc2)
+
+    threading.Thread(target=work, daemon=True).start()
+
