+def _minimax_click_vstopite_js() -> str:
+    """Vhodna stran moj.minimax.si: gumb »Vstopite v program« (screenshot peach)."""
+    return """
+(() => {
+  const txt = (el) => ((el && (el.innerText || el.textContent || el.value
+    || el.getAttribute('aria-label') || el.getAttribute('title'))) || '')
+    .replace(/\\s+/g, ' ').trim();
+  const visible = (el) => {
+    if (!el) return false;
+    const r = el.getBoundingClientRect();
+    const st = window.getComputedStyle(el);
+    return r.width > 8 && r.height > 8
+      && st.visibility !== 'hidden' && st.display !== 'none' && st.opacity !== '0';
+  };
+  const fire = (el) => {
+    if (!el) return false;
+    try { el.scrollIntoView({ block: 'center', inline: 'center' }); } catch (e) {}
+    try { el.focus(); } catch (e) {}
+    try { el.click(); return true; } catch (e) {}
+    try {
+      el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
+      return true;
+    } catch (e) { return false; }
+  };
+  const match = (s) => /vstopite(\\s+v\\s+program)?/i.test(s || '') || /vstop.*program/i.test(s || '');
+  const sel = 'a, button, input[type=button], input[type=submit], [role="button"], span, div';
+  const nodes = Array.from(document.querySelectorAll(sel)).filter(visible);
+  let hit = nodes.find(el => match(txt(el)));
+  if (!hit) {
+    // peach: edini primarni gumb na golem moj.minimax.si
+    hit = nodes.find(el => {
+      const tag = (el.tagName || '').toLowerCase();
+      const role = (el.getAttribute('role') || '').toLowerCase();
+      if (!(tag === 'a' || tag === 'button' || tag === 'input' || role === 'button')) return false;
+      const t = txt(el);
+      return t.length >= 4 && t.length < 48 && /vstop/i.test(t);
+    });
+  }
+  if (!hit) return { ok: false, reason: 'no_button', href: location.href, title: document.title || '' };
+  const clickable = hit.closest('a, button, [role="button"]') || hit;
+  if (!fire(clickable)) return { ok: false, reason: 'click_failed', text: txt(clickable) };
+  return { ok: true, text: txt(clickable), href: location.href, title: document.title || '' };
+})()
+""".strip()
+
+
+def _minimax_click_uvoz_iz_excela_js(
+    *,
+    organisation_id: Optional[int] = None,
+    organisation_name: str = "",
+) -> str:
+    """
+    Video frames: v firmi (navbar ALFA GYM) → zobnik zgoraj desno →
+    Nastavitve organizacije → Uvoz iz Excela.
+    Če še Moje org: zobnik v vrstici ciljne firme (Nastavitve), sicer header.
+    """
+    oid = json.dumps(str(int(organisation_id)) if organisation_id else "")
+    onm = json.dumps(str(organisation_name or "").strip().lower())
+    return f"""
+(() => {{
+  const oid = {oid};
+  const onm = {onm};
+  const txt = (el) => ((el && (el.innerText || el.textContent || el.value)) || '').replace(/\\s+/g, ' ').trim();
+  const fire = (el) => {{
+    if (!el) return false;
+    try {{ el.click(); return true; }} catch (e) {{}}
+    try {{
+      el.dispatchEvent(new MouseEvent('click', {{ bubbles: true, cancelable: true, view: window }}));
+      return true;
+    }} catch (e) {{ return false; }}
+  }};
+  const findUvozLink = () => Array.from(document.querySelectorAll('a')).find(a =>
+    /uvoz\\s*iz\\s*excel/i.test(txt(a)) || /UvozPodatkovCSV\\.aspx/i.test(a.getAttribute('href') || '')
+  );
+  const path = location.pathname || '';
+  if (/UvozPodatkovCSV/i.test(path)) {{
+    return {{ ok: true, how: 'already_uvoz', path }};
+  }}
+  let hit = findUvozLink();
+  if (hit && fire(hit)) return {{ ok: true, how: 'link_visible', href: hit.getAttribute('href') || '', text: txt(hit) }};
+
+  const onOrgList = /Zacetek\\.aspx/i.test(path) && !/ZacetekOrganizacije/i.test(path);
+  // Moje org: zobnik v vrstici ciljne firme (stolpec Nastavitve)
+  if (onOrgList) {{
+    let row = null;
+    if (oid) row = document.querySelector('tr[data-organizacijaid="' + oid + '"], tr.prijava[data-organizacijaid="' + oid + '"]');
+    if (!row && onm && onm.length > 2) {{
+      row = Array.from(document.querySelectorAll('tr.prijava, tr[data-organizacijaid], tr')).find(tr => {{
+        const t = txt(tr).toLowerCase();
+        return t.includes(onm) || (onm.split(/\\s+/).filter(p => p.length >= 3).slice(0, 2).every(p => t.includes(p)));
+      }}) || null;
+    }}
+    if (row) {{
+      const gearInRow = Array.from(row.querySelectorAll('a, button, span, i, div')).find(el => {{
+        const cls = (el.className || '').toString().toLowerCase();
+        const aria = (el.getAttribute('aria-label') || '').toLowerCase();
+        const title = (el.getAttribute('title') || '').toLowerCase();
+        const r = el.getBoundingClientRect();
+        if (!(r.width > 0 && r.height > 0)) return false;
+        return /icon-settings|settings|nastavit|gear|cog/.test(cls + ' ' + aria + ' ' + title);
+      }});
+      if (gearInRow) {{
+        fire(gearInRow.closest('a, button') || gearInRow);
+        hit = findUvozLink();
+        if (hit && fire(hit)) return {{ ok: true, how: 'row_gear_then_link', text: txt(hit) }};
+      }}
+    }}
+  }}
+
+  // V firmi: zobnik v headerju (zgoraj desno) — video frame 5–6
+  const gearCandidates = Array.from(document.querySelectorAll('a, button, span, i, div')).filter(el => {{
+    const t = txt(el).toLowerCase();
+    const cls = (el.className || '').toString().toLowerCase();
+    const aria = (el.getAttribute('aria-label') || '').toLowerCase();
+    const title = (el.getAttribute('title') || '').toLowerCase();
+    const r = el.getBoundingClientRect();
+    if (!(r.width > 0 && r.height > 0 && r.top < 100)) return false;
+    return /icon-settings|settings|nastavit/.test(cls + ' ' + aria + ' ' + title)
+      || (t === '' && /gear|cog|settings/.test(cls));
+  }});
+  const vw = window.innerWidth || 1200;
+  const gear = gearCandidates.sort((a, b) => b.getBoundingClientRect().left - a.getBoundingClientRect().left)
+    .find(el => el.getBoundingClientRect().left > vw * 0.55)
+    || gearCandidates[0]
+    || document.querySelector('[class*="settings"], [class*="icon-settings"], a[title*="Nastavit"]');
+  if (gear) fire(gear.closest('a, button') || gear);
+
+  // meni se odpre asinhrono — kratko počakaj v JS ni mogoče; klicatelj lahko retry
+  hit = findUvozLink();
+  if (hit && fire(hit)) return {{ ok: true, how: 'header_gear_then_link', href: hit.getAttribute('href') || '', text: txt(hit) }};
+  return {{
+    ok: false,
+    how: 'not_found',
+    path,
+    onOrgList,
+    gears: gearCandidates.length,
+    title: document.title || ''
+  }};
+}})()
+""".strip()
+
