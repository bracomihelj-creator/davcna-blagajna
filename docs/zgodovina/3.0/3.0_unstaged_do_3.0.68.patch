+
+        # 2) Datum
+        date_script = (
+            "(()=>{"
+            + set_native_js
+            + f"const el=document.querySelector('#PPC_EPC_DC_I_Datum');"
+            + f"const ok=setNative(el,{json.dumps(date_sl)});"
